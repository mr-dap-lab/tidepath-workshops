DATABASE_URL=postgresql://localhost/tidepath
PORT=3000

# Optional. Use an HTTPS base origin for a shared deployment.
# APP_ORIGIN=https://workshops.example.org
# APP_BIND=127.0.0.1
# DECK_STORAGE_DIR=/absolute/path/to/private/decks

# Optional Google OAuth web client and 32-byte encryption key (64 hex characters).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/google/callback
# GOOGLE_TOKEN_KEY=

# Optional structured model and SMS relay services.
# MODEL_ENDPOINT=
# MODEL_API_KEY=
# SMS_WEBHOOK_KEY=
# SMS_RELAY_URL=

# First platform administrator for an HTTPS deployment.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
